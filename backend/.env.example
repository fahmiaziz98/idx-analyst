# ==================== Server Configuration ====================
API_TITLE="IDX-Analyst RAG API"
API_VERSION="1.0.0"
API_DESCRIPTION="Production-ready RAG system for Indonesian financial reports"
ENVIRONMENT=development  # development | staging | production

# ==================== Security Configuration ====================
API_KEYS_ENCRYPTED=encrypted_api_keys_here
ENCRYPTION_KEY=your_encryption_key_here
API_KEYS=your_plain_api_keys_here

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=7860
WORKERS=4

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100  # requests per window
RATE_LIMIT_WINDOW=60     # seconds

# ==================== External API Keys ====================
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
COHERE_API_KEY=your_cohere_api_key_here(Optional)
LLAMA_PARSE_KEY=your_llama_parse_key_here
MEM0_API_KEY=your_mem0_api_key_here(Optional)

# ==================== Embedding Service ====================
EMBEDDING_API_URL=https://fahmiaziz-api-embedding.hf.space/api/v1

# ==================== Qdrant Configuration ====================
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_BASE_URL=https://your-qdrant-instance-url:port
COLLECTION=document

# ==================== Monitoring ====================
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL